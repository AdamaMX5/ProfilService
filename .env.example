PORT=4000
# Zentrale MongoDB-Instanz (geteilt von allen Services) — profilservice bekommt hier
# nur seine eigene DB innerhalb dieser Instanz, KEIN eigener Mongo-Container/Deployment.
MONGODB_URI=mongodb://<central-mongo-host>:27017/profilservice
AUTH_SERVER_URL=https://auth.freischule.info
NODE_ENV=development

# One INTERNAL_API_KEY_<SERVICENAME> per caller of POST /internal/xp-events — never a
# shared master key. Rotation = change the value + redeploy.
INTERNAL_API_KEY_WAVE_SERVICE=
INTERNAL_API_KEY_ACTIVATION_SERVICE=
